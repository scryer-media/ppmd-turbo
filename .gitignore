/target/
/target-*/

# Agent and topic-branch worktrees live inside the checkout.
/.worktrees/

# Local CI/release artifacts
/.ci-*.txt
/dist/
/package/
/logs/
/SHA256SUMS

# Benchmark fixtures and results are generated locally.
/bench/**/fixtures/
/bench/**/results/

# Rust profiling/coverage
/coverage/
*.profraw
*.profdata
/perf.data*
/*.trace/

# Local environment/secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
**/.DS_Store
._*

# Cargo-fuzz build state, corpora and crash artifacts. fuzz/Cargo.lock is
# tracked, so the harness builds against the versions CI audits.
**/fuzz/target/
**/fuzz/artifacts/
**/fuzz/corpus/
**/fuzz/coverage/
