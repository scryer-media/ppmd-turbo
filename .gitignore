/target/
/target-*/

# Agent and topic-branch worktrees live inside the checkout.
/.worktrees/

# Local CI/release artifacts
/.ci-*.txt
/dist/
/package/
/logs/
/SHA256SUMS

# Benchmark fixtures are generated locally. Results are too, except each
# run's report.md and report.json, which are committed as the record.
/bench/fixtures/
/bench/results/**
!/bench/results/*/
!/bench/results/*/report.md
!/bench/results/*/report.json
/bench/ppmd-turbo-bench/ppmd-turbo-bench
/bench/ppmd-turbo-bench/ppmd-turbo-bench.exe

# Rust profiling/coverage
/coverage/
*.profraw
*.profdata
/perf.data*
/*.trace/

# Local environment/secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
**/.DS_Store
._*

# Cargo-fuzz build state, corpora and crash artifacts. fuzz/Cargo.lock is
# tracked, so the harness builds against the versions CI audits.
**/fuzz/target/
**/fuzz/artifacts/
**/fuzz/corpus/
**/fuzz/coverage/
