/target/
/target-*/

# Agent and topic-branch worktrees live inside the checkout.
/.worktrees/

# Local CI/release artifacts
/.ci-*.txt
/dist/
/package/
/logs/
/SHA256SUMS

# Generated fixtures: never committed. `cargo run --locked --release -p
# ppmd-corpus -- fixtures` writes them and checks each against
# tools/ppmd-corpus/fixtures.sha256. tests/fixtures/manifest.json, the
# conformance recipe, is committed.
/tests/fixtures/7z/
/tests/fixtures/rar/
/tests/hostile_fixtures/
/fuzz/seeds/
/fuzz/regressions/

# Benchmark fixtures and results are generated locally and never committed:
# a run's report names the host it ran on.
/bench/fixtures/
/bench/results/
/bench/ppmd-turbo-bench/ppmd-turbo-bench
/bench/ppmd-turbo-bench/ppmd-turbo-bench.exe

# Rust profiling/coverage
/coverage/
*.profraw
*.profdata
/perf.data*
/*.trace/

# Local environment/secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
**/.DS_Store
._*

# Cargo-fuzz build state, corpora and crash artifacts. fuzz/Cargo.lock is
# tracked, so the harness builds against the versions CI audits.
**/fuzz/target/
**/fuzz/artifacts/
**/fuzz/corpus/
**/fuzz/coverage/
